{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "literstella-api",
  // 🔴 라이브와 같은 모양으로 배포한다(2026-10-17 정리 — LIVE-SOURCE.md).
  //   라이브 진입은 src/index.js 가 아니라 class-checkout-email-entry.mjs 다(결제 감싸기 사슬:
  //   class-checkout-email-entry → class-member-checkout-entry → class-payment-probe-entry → index.js).
  //   진입을 index.js 로 두면 /api/class-checkout/*·결제 메일 재시도가 통째로 빠진다(2026-10-17 사고, 90분).
  //   build 명령(ops/build-live.mjs)이 src/index.js 를 index.js 한 파일로 묶고 결제 모듈 8개를 그대로 옆에 둔
  //   dist/live/ 를 만들고, 그 폴더를 묶지 않고 그대로 올린다 → 모듈 9개·이름·바이트가 라이브와 같다.
  "main": "dist/live/class-checkout-email-entry.mjs",
  "build": { "command": "node ops/build-live.mjs" },
  "no_bundle": true,
  "base_dir": "dist/live",
  "find_additional_modules": true,
  "rules": [{ "type": "ESModule", "globs": ["*.mjs", "index.js"] }],
  "compatibility_date": "2026-06-17",
  "compatibility_flags": ["nodejs_compat"],

  // OTP 무차별 대입 방어용 상태 저장소(2026-08-12).
  //   왜 필요한가: OTP 토큰이 `exp.HMAC(email:code:exp)` 라 **서버에 상태가 없었다** — 토큰을 받은 뒤
  //   6자리 100만 가지를 대입하면 뚫린다. 남의 명단 이메일 하나만 알면 그 사람 소장 강좌가 공격자 계정으로
  //   넘어가고, 원 소유자는 alreadyLinked 로 영구히 막힌다. 시도 횟수를 적을 곳이 없어 코드로는 못 막았다.
  //   → 토큰 자체의 해시를 키로 삼아 시도 횟수를 센다(토큰 형식 불변 = 클라 무수정).
  "kv_namespaces": [
    { "binding": "OTP_GUARD", "id": "4d63990bf864475fb20f5847ac1c016e" }
  ],

  // 발송 제한은 KV 로 못 한다 — **KV 는 "키 없음"을 최대 60초 캐시**해서(negative caching)
  //   첫 발송 뒤에도 읽기가 계속 null 을 본다(2026-08-12 실측: 4연속 발송 전부 통과).
  //   시도 카운터는 발급 시점에 키가 이미 생기므로 영향을 안 받아 정상 작동한다 — 같은 KV 인데 결과가 갈린 이유.
  //   → 발송 제한만 전용 Rate Limiting 바인딩으로. 이메일당 60초에 3통.
  "ratelimits": [
    { "name": "OTP_SEND_LIMIT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }
  ],

  // 인증·계정 복구·수강 연결 메일은 진단 Worker의 비공개 RPC로 보낸다.
  // Resend 인증 키는 target Worker 한 곳만 소유한다(시크릿 사본 드리프트 방지).
  "services": [
    {
      "binding": "AUTH_EMAIL_SERVICE",
      "service": "literstella-reading-diagnosis",
      "entrypoint": "AuthEmailService"
    },
    // 올인원 8/8 판정 정본(출간본 게이트 ownsAllInOne) — 라일라 소울 두 번째 문(2026-09-25).
    //   /api/points/content/progress 가 /premium-status 에 회원 토큰으로 묻는다. 새로 정의하지 않는다.
    { "binding": "CLASS_GATE", "service": "literstella-class-gate" }
  ],

  // 라이브 plain 변수 15개와 이름·값이 같다(2026-10-17 settings 실측). 여기 없는 변수는 배포 때 지워진다 —
  //   새 변수는 여기에 먼저 적는다(대시보드에서만 바꾸면 다음 배포가 되돌린다).
  //   폐기한 옛 결제 공급자의 공개 설정 2개는 2026-10-12 운영에서 지웠다(10-12 폐기 인계 — README.md '2026-10-12 연동 폐기') — 되살리지 말 것.
  "vars": {
    "SPEAKING_ENABLED": "true", // 2026-10-11 operator activation; DB trial expiry and five-concurrent guard remain authoritative.
    "ADMIN_API_ENABLED": "true",    // #8b 관리자 service_role 라우트 — ON(총괄 2026-08-14, 운영자 지시로 강의 알림 메일 발송 경로 개방)
    //   🔴 이 라우트는 전부 **관리자 이메일 OTP**(/api/admin/auth) 뒤에 있다 — 플래그만으로는 아무도 발송 못 한다.
    "CONTENT_SEND_ENABLED": "true", // 콘텐츠 알림 실발송(mode:"send") 허용 — dry/test 는 이 값과 무관
    "PAYMENT_ENABLED": "true",       // 토스 승인 및 웹훅 라우트(옛 결제 공급자의 결제·빌링·본인인증 라우트는 2026-10-12 폐기로 코드에서 제거)
    "CONTENT_POINTS_ENABLED": "true",  // SQL/RLS/RPC 검증 완료(2026-07-29): 카탈로그 활성 회차만 해금
    "SUPABASE_URL": "https://bvhkvucsoetktoxzupwt.supabase.co",
    "ADMIN_EMAIL": "literbryanbae@gmail.com",
    // OTP·알림 메일 발신자 — Resend 인증한 @literstella.co.kr 도메인이라 임의 수신자에게 도달.
    // (미설정 시 코드 폴백 onboarding@resend.dev = 본인 메일만). local-part는 원하면 변경 가능.
    "RESEND_FROM": "리터스텔라 <noreply@literstella.co.kr>",
    "RESEND_STELLA_OPTIN_SEGMENT_ID": "c0cfb2fe-eaf9-47b7-9cf2-c5122192da1a",
    // 발음 평가(2026-09-28 운영자 승인 운영 — PRONUNCIATION-RELEASE-20260928.md). 값은 라이브 그대로.
    "PRONUNCIATION_ENABLED": "true",
    "PRONUNCIATION_OPERATOR_CONTROLLED": "true",
    "PRONUNCIATION_PILOT_ACTIVATED_AT": "2026-09-27T21:57:10Z",
    "ETRI_HTTP_PILOT_APPROVED": "true",
    "ETRI_SERVICE_USE_APPROVED": "true",
    // CORS 허용 Origin (쉼표구분) — 프론트 도메인만. 클래스 앱(강독 이관, 2026-07-18) 추가:
    //   class-new=스테이징 · class=컷오버 후 · pages.dev=배포 프리뷰 QA
    "ALLOWED_ORIGINS": "https://challenge.literstella.co.kr,https://read.literstella.co.kr,https://literstella.co.kr,https://class-new.literstella.co.kr,https://class.literstella.co.kr,https://literstella-class.pages.dev,https://english.literstella.co.kr"
  },

  // secret 10개(라이브 2026-10-17 실측 — 값은 저장소 밖, `wrangler secret put <NAME>`). 배포는 반드시 --keep-vars:
  //   SUPABASE_SERVICE_ROLE_KEY  — service_role (브라우저 노출 금지)
  //   OTP_SECRET                 — diag Worker와 동일 값(회원가입·관리자 OTP 토큰 서명/검증 공유) ★회원가입 필수
  //   ADMIN_SECRET               — 관리자 세션 토큰 서명용
  //   RESEND_API_KEY             — 대량 캠페인/마케팅 전용. 인증 키를 이 Worker에 복사하지 말 것.
  //   RESEND_WEBHOOK_SECRET      — Resend 웹훅 서명 검증
  //   TOSS_SECRET_KEY            — 토스 다이렉트 결제(챌린지)
  //   TOSS_CLASS_SECRET_KEY      — 클래스 결제 위젯 MID lclassljzq(회원·강좌 결제·100원 시험)
  //   SPEECHSUPER_APP_KEY / SPEECHSUPER_SECRET_KEY — 스피킹 분석 전용. 브라우저/저장소에 값 공개 금지.
  //   ETRI_API_KEY               — 발음 평가
  //   (폐기한 옛 결제 공급자의 secret 2개는 2026-10-12 삭제)
  // 인증 메일 필수 의존성은 위 AUTH_EMAIL_SERVICE 바인딩이다.

  // 크론 2개 = 라이브와 같다. 하나만 남기면 다른 하나가 지워진다.
  //   "25 18 * * *" — 매일 03:25 KST 평가단 신청 보관기한 경과분 파기(index.js GROWTH_PANEL_PURGE_CRON)
  //   "*/5 * * * *" — 클래스 결제 메일 재시도(class-checkout-email-entry.mjs scheduled, 2026-10-12)
  "triggers": { "crons": ["25 18 * * *", "*/5 * * * *"] },

  "observability": { "enabled": true }
}
